        "focus": [
          "dev",
          "repo",
          "build",
          "hub"
        ],
        "note": "Un push a gitops-argocd dispara el workflow: build multi-arch (amd64+arm64) y push sha-xxxxxxx + latest a Docker Hub."
      },
      {
        "id": "gitops-commit",
        "label": "2 · Git como fuente de verdad",
        "focus": [
          "build",
          "manifests",
          "repo"
        ],
        "note": "update-manifests cambia el tag en k8s/deployment.yaml con sed y el bot hace commit. paths-ignore k8s/** evita el bucle."
      },
      {
        "id": "cd",
        "label": "3 · CD con ArgoCD",
        "focus": [
          "repo",
          "argocd",
          "ui",
          "deploy"
        ],
        "note": "ArgoCD consulta Git cada ~3 min, ve el commit (OutOfSync) y aplica k8s/ en el namespace cat-gif."
      },
      {
        "id": "runtime",
        "label": "4 · Rolling update y app",
        "focus": [
          "hub",
          "deploy",
          "svc",
          "browser"
        ],
        "note": "Kubernetes descarga la imagen nueva, reemplaza los pods y el navegador muestra Versión sha-xxxxxxx."
      }
    ]
  },
